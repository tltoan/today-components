  "components": [
    {
      "id": "disclosure",
      "name": "Dropdown/disclosure motion",
      "preview": "index.html",
      "browserSource": [
        "foundations/motion.css",
        "foundations/disclosure.js"
      ],
      "swiftSource": [
        "native/TodayMotion.swift"
      ],
      "dependencies": [],
      "status": "Approved shared 600 ms motion.",
      "sourcePage": "source.html#disclosure",
      "browserIntegration": {
        "kind": "controller",
        "styles": [
          "foundations/motion.css"
        ],
        "scripts": [
          "foundations/disclosure.js"
        ],
        "usage": "new TodayUI.Disclosure(panel, {trigger, open: false}); panel needs one inner content wrapper."
      }
    },
    {
      "id": "dropdown",
      "name": "Selection dropdown",
      "preview": "index.html",
      "browserSource": [
        "components/dropdown.js",
        "components/dropdown.css"
      ],
      "swiftSource": [],
      "dependencies": [
        "disclosure"
      ],
      "status": "Reusable browser selection control.",
      "sourcePage": "source.html#dropdown",
      "browserIntegration": {
        "kind": "custom-element",
        "tag": "today-dropdown",
        "styles": [
          "components/dropdown.css",
          "foundations/motion.css"
        ],
        "scripts": [
          "foundations/disclosure.js",
          "components/dropdown.js"
        ],
        "markup": "<today-dropdown label=\"Tracking method\" value=\"pages\"><option value=\"pages\">Pages</option><option value=\"minutes\">Minutes</option></today-dropdown>"
      }
    },
